# Supabase project (public values)
NEXT_PUBLIC_SUPABASE_URL=https://dceyqaobmasqibclchdg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Demo sign-in: one shared password for the sample personas. Remove to turn demo sign-in off.
DEMO_PASSWORD=
# Server-only keys (set in Vercel, never in the browser). Each feature stays off until its key is set.
# Adding people by invite email and the daily email run use the service role key.
SUPABASE_SERVICE_ROLE_KEY=
# Protects /api/cron/daily (Vercel sends it as a Bearer token when CRON_SECRET is set).
CRON_SECRET=
# Email for notifications (https://resend.com). EMAIL_FROM must be a sender on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM=
# The public address of the app, used in email links.
APP_URL=https://coded-quality-system.vercel.app
